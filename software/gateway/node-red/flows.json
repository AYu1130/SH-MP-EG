[
  {
    "id": "tab-shmpeg",
    "type": "tab",
    "label": "SH-MP-EG Cross-Node Rules",
    "disabled": false,
    "info": "异构终端节点互通示例：\n- 订阅 telemetry/+/+，分别缓存最近一次 wifi/ble 节点的 device_id\n- BLE 节点变暗 -> 给 Wi-Fi (ESP32) 发 {\"led\":\"yellow\"}\n- BLE 节点恢复明亮 -> 给 Wi-Fi 发 {\"auto\":true} 释放远程接管\n- Wi-Fi 节点温度 > 28°C -> 给 BLE (STM32) 发 {\"beep\":3}\n- 命令通过 smarthome/v1/command/<type>/<id> 发布，由网关转换到对应物理协议"
  },

  {
    "id": "tab-dashboard",
    "type": "tab",
    "label": "Dashboard",
    "disabled": false,
    "info": "SH-MP-EG 仪表盘：传感器数据实时展示、LED/蜂鸣器状态监控与设备控制"
  },

  {
    "id": "mqtt-broker-cfg",
    "type": "mqtt-broker",
    "name": "local-emqx",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "node-red-shmpeg",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "30",
    "cleansession": true
  },

  {
    "id": "mqtt-in-telemetry",
    "type": "mqtt in",
    "z": "tab-shmpeg",
    "name": "sub: telemetry/+/+",
    "topic": "smarthome/v1/telemetry/+/+",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt-broker-cfg",
    "x": 140,
    "y": 120,
    "wires": [["cache-peer-id"]]
  },

  {
    "id": "cache-peer-id",
    "type": "function",
    "z": "tab-shmpeg",
    "name": "cache last seen device_id (per type)",
    "func": "const p = msg.payload || {};\nconst t = p.device_type;\nconst id = p.device_id;\nif (t && id) {\n  flow.set('last_id_' + t, id);\n  flow.set('last_seen_' + t, Date.now());\n}\nreturn msg;\n",
    "outputs": 1,
    "x": 380,
    "y": 120,
    "wires": [["split-by-type"]]
  },

  {
    "id": "split-by-type",
    "type": "switch",
    "z": "tab-shmpeg",
    "name": "split by device_type",
    "property": "payload.device_type",
    "propertyType": "msg",
    "rules": [
      { "t": "eq", "v": "wifi", "vt": "str" },
      { "t": "eq", "v": "ble", "vt": "str" }
    ],
    "checkall": "true",
    "outputs": 2,
    "x": 640,
    "y": 120,
    "wires": [["rule-temp-high"], ["rule-light-low"]]
  },

  {
    "id": "rule-temp-high",
    "type": "switch",
    "z": "tab-shmpeg",
    "name": "wifi temp > 28 ?",
    "property": "payload.payload.temperature",
    "propertyType": "msg",
    "rules": [
      { "t": "gt", "v": "28", "vt": "num" }
    ],
    "checkall": "true",
    "outputs": 1,
    "x": 870,
    "y": 80,
    "wires": [["build-ble-beep"]]
  },

  {
    "id": "build-ble-beep",
    "type": "function",
    "z": "tab-shmpeg",
    "name": "-> BLE beep 3 (cross-node)",
    "func": "const peer = flow.get('last_id_ble');\nif (!peer) {\n  node.warn('no BLE peer cached, skip');\n  return null;\n}\nconst src = msg.payload.device_id;\nconst srcSeq = (msg.payload && msg.payload.payload && msg.payload.payload.seq);\nreturn {\n  topic: `smarthome/v1/command/ble/${peer}`,\n  payload: { beep: 3, reason: 'wifi_temp_high', src: src, src_seq: srcSeq, ts: Date.now() }\n};\n",
    "outputs": 1,
    "x": 1110,
    "y": 80,
    "wires": [["mqtt-out-cmd"]]
  },

  {
    "id": "rule-light-low",
    "type": "function",
    "z": "tab-shmpeg",
    "name": "ble light state machine (hysteresis)",
    "func": "const p = (msg.payload && msg.payload.payload) || {};\nif (p.keepalive) return null;\nconst light = (typeof p.light === 'number') ? p.light : ((typeof p.l === 'number') ? p.l : undefined);\nlet prev = flow.get('ble_dark_state');\nif (prev === undefined) prev = false;\nlet next = prev;\nif (typeof light === 'number') {\n  if (light < 70) next = true;\n  else if (light > 130) next = false;\n} else if (p.dark === true || p.d === 1) {\n  next = true;\n} else if (p.dark === false || p.d === 0) {\n  next = false;\n}\nflow.set('ble_dark_state', next);\nif (!prev && next) return [msg, null];\nif (prev && !next) return [null, msg];\nreturn null;\n",
    "outputs": 2,
    "x": 870,
    "y": 160,
    "wires": [["build-wifi-led"], ["build-wifi-auto"]]
  },

  {
    "id": "rule-light-bright",
    "type": "function",
    "z": "tab-shmpeg",
    "name": "ble bright? (inverse of dark)",
    "func": "const p = (msg.payload && msg.payload.payload) || {};\nif (p.keepalive) return null;\nconst light = p.light !== undefined ? p.light : p.l;\nconst dark  = (p.dark === true) || (p.d === 1) || (typeof light === 'number' && light < 100);\nreturn dark ? null : msg;\n",
    "outputs": 1,
    "x": 880,
    "y": 220,
    "wires": [["build-wifi-auto"]]
  },

  {
    "id": "build-wifi-auto",
    "type": "function",
    "z": "tab-shmpeg",
    "name": "-> Wi-Fi auto (release)",
    "func": "const peer = flow.get('last_id_wifi');\nif (!peer) {\n  node.warn('no Wi-Fi peer cached, skip');\n  return null;\n}\nconst src = msg.payload.device_id;\nreturn {\n  topic: `smarthome/v1/command/wifi/${peer}`,\n  payload: { auto: true, reason: 'ble_bright', src: src, ts: Date.now() }\n};\n",
    "outputs": 1,
    "x": 1110,
    "y": 220,
    "wires": [["mqtt-out-cmd"]]
  },

  {
    "id": "build-wifi-led",
    "type": "function",
    "z": "tab-shmpeg",
    "name": "-> Wi-Fi LED yellow (cross-node)",
    "func": "const peer = flow.get('last_id_wifi');\nif (!peer) {\n  node.warn('no Wi-Fi peer cached, skip');\n  return null;\n}\nconst src = msg.payload.device_id;\nconst srcSeq = (msg.payload && msg.payload.payload && msg.payload.payload.seq);\nreturn {\n  topic: `smarthome/v1/command/wifi/${peer}`,\n  payload: { led: 'yellow', reason: 'ble_dark', src: src, src_seq: srcSeq, ts: Date.now() }\n};\n",
    "outputs": 1,
    "x": 1110,
    "y": 160,
    "wires": [["mqtt-out-cmd"]]
  },

  {
    "id": "mqtt-out-cmd",
    "type": "mqtt out",
    "z": "tab-shmpeg",
    "name": "pub: command",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "broker": "mqtt-broker-cfg",
    "x": 1340,
    "y": 120,
    "wires": []
  },

  {
    "id": "debug-telemetry",
    "type": "debug",
    "z": "tab-shmpeg",
    "name": "debug: telemetry",
    "active": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 380,
    "y": 220,
    "wires": []
  },

  {
    "id": "dash-mqtt-in",
    "type": "mqtt in",
    "z": "tab-dashboard",
    "name": "sub: all telemetry",
    "topic": "smarthome/v1/telemetry/+/+",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt-broker-cfg",
    "x": 140,
    "y": 120,
    "wires": [["dash-parse-sensor"]]
  },

  {
    "id": "dash-parse-sensor",
    "type": "function",
    "z": "tab-dashboard",
    "name": "parse sensor data",
    "func": "const p = (msg.payload && msg.payload.payload) || {};\nconst devType = (msg.payload && msg.payload.device_type) || 'unknown';\nconst devId = (msg.payload && msg.payload.device_id) || 'unknown';\n\nconst msgs = [];\n\nif (typeof p.temperature === 'number') {\n  msgs.push({\n    topic: 'temperature',\n    payload: p.temperature,\n    device_type: devType,\n    device_id: devId\n  });\n}\nif (typeof p.humidity === 'number') {\n  msgs.push({\n    topic: 'humidity',\n    payload: p.humidity,\n    device_type: devType,\n    device_id: devId\n  });\n}\n\nconst lightVal = (typeof p.light === 'number') ? p.light : ((typeof p.l === 'number') ? p.l : ((typeof p.illuminance === 'number') ? p.illuminance : undefined));\nif (typeof lightVal === 'number') {\n  msgs.push({\n    topic: 'light',\n    payload: lightVal,\n    device_type: devType,\n    device_id: devId\n  });\n}\n\nif (typeof p.led === 'string') {\n  flow.set('led_status_' + devType, { color: p.led, device_id: devId, device_type: devType, ts: Date.now() });\n  msgs.push({\n    topic: 'led_status',\n    payload: p.led,\n    device_type: devType,\n    device_id: devId\n  });\n}\n\nif (typeof p.buzzer !== 'undefined' || typeof p.beep !== 'undefined') {\n  const buzzVal = (typeof p.buzzer === 'number') ? p.buzzer : (typeof p.beep === 'number') ? p.beep : 0;\n  flow.set('buzzer_status_' + devType, { active: buzzVal > 0, value: buzzVal, device_id: devId, device_type: devType, ts: Date.now() });\n  msgs.push({\n    topic: 'buzzer_status',\n    payload: buzzVal > 0 ? 'ON' : 'OFF',\n    device_type: devType,\n    device_id: devId\n  });\n}\n\nif (typeof p.alarm !== 'undefined') {\n  msgs.push({\n    topic: 'alarm',\n    payload: p.alarm ? 'ACTIVE' : 'INACTIVE',\n    device_type: devType,\n    device_id: devId\n  });\n}\n\nreturn msgs.length > 0 ? [msgs] : null;\n",
    "outputs": 1,
    "x": 380,
    "y": 120,
    "wires": [["dash-split-topic"]]
  },

  {
    "id": "dash-split-topic",
    "type": "switch",
    "z": "tab-dashboard",
    "name": "split by topic",
    "property": "topic",
    "propertyType": "msg",
    "rules": [
      { "t": "eq", "v": "temperature", "vt": "str" },
      { "t": "eq", "v": "humidity", "vt": "str" },
      { "t": "eq", "v": "light", "vt": "str" },
      { "t": "eq", "v": "led_status", "vt": "str" },
      { "t": "eq", "v": "buzzer_status", "vt": "str" },
      { "t": "eq", "v": "alarm", "vt": "str" }
    ],
    "checkall": "true",
    "outputs": 6,
    "x": 640,
    "y": 120,
    "wires": [
      ["dash-temp-gauge", "dash-temp-chart"],
      ["dash-hum-gauge", "dash-hum-chart"],
      ["dash-light-gauge", "dash-light-chart"],
      ["dash-led-text"],
      ["dash-buzzer-text"],
      ["dash-alarm-text"]
    ]
  },

